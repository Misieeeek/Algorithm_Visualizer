{
    "version": 4,
    "vendor": {
        "conan": {}
    },
    "configurePresets": [
        {
            "name": "gcc-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gcc-debug/cmake",
            "toolchainFile": "${sourceDir}/build/gcc-debug/build/Debug/generators/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            }
        },
        {
            "name": "gcc-release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gcc-release/cmake",
            "toolchainFile": "${sourceDir}/build/gcc-release/build/Release/generators/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            }
        },
        {
            "name": "clang-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clang-debug/cmake",
            "toolchainFile": "${sourceDir}/build/clang-debug/build/Debug/generators/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        },
        {
            "name": "clang-release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clang-release/cmake",
            "toolchainFile": "${sourceDir}/build/clang-release/build/Release/generators/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        }
    ],
    "buildPresets": [
        { "name": "gcc-debug",     "configurePreset": "gcc-debug" },
        { "name": "gcc-release",   "configurePreset": "gcc-release" },
        { "name": "clang-debug",   "configurePreset": "clang-debug" },
        { "name": "clang-release", "configurePreset": "clang-release" }
    ]
}
